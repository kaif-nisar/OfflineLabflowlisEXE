{
  "name": "labflow-offline-desktop",
  "description": "LabFlow - Advanced Pathology Software",
  "author": "LabFlow",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ./scripts/start-electron.js",
    "icon:create": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-app-icon.ps1",
    "start": "node ./scripts/start-electron.js",
    "start:electron": "node ./scripts/start-electron.js",
    "backup:create": "node create-backup.js",
    "build:exe": "node ./scripts/build-electron.js --setup",
    "exe": "node ./scripts/build-electron.js --setup",
    "build:electron": "node ./scripts/build-electron.js --all",
    "build:electron:dir": "node ./scripts/build-electron.js --dir",
    "build:electron:portable": "node ./scripts/build-electron.js --portable",
    "build:electron:setup": "node ./scripts/build-electron.js --setup",
    "release:setup": "node ./scripts/build-electron.js --setup --require-signature"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.8.0",
    "canvas": "^3.2.2",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.40.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4"
  },
  "build": {
    "appId": "com.labflow.desktop",
    "productName": "LabFlow",
    "executableName": "LabFlow",
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "app.js",
      "electron/**/*",
      "middlewares/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "chromium",
        "to": "runtime-bundle/chromium"
      },
      {
        "from": "mongodb",
        "to": "runtime-bundle/mongodb"
      },
      {
        "from": "public",
        "to": "runtime-bundle/public"
      },
      {
        "from": "private",
        "to": "runtime-bundle/private"
      },
      {
        "from": "uploads",
        "to": "runtime-bundle/uploads"
      },
      {
        "from": "data/seed",
        "to": "runtime-bundle/data/seed"
      },
      {
        "from": "labflow-database-backup",
        "to": "runtime-bundle/labflow-database-backup"
      },
      {
        "from": ".env",
        "to": "runtime-bundle/.env"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "win": {
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerHeaderIcon": "assets/app-icon.ico",
      "shortcutName": "LabFlow",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
